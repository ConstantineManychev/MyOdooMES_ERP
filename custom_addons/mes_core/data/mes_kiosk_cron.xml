<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_prompt_operator_confirmation" model="ir.cron">
            <field name="name">MES Kiosk: Prompt Operator Confirmation</field>
            <field name="model_id" ref="model_mes_task"/>
            <field name="state">code</field>
            <field name="code">model.cron_prompt_operator_confirmation()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_rollover_kiosk_downtime" model="ir.cron">
            <field name="name">MES Kiosk: Roll Over Planned Downtime</field>
            <field name="model_id" ref="model_mes_planned_downtime"/>
            <field name="state">code</field>
            <field name="code">model.roll_over_kiosk_downtime()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_close_stale_kiosk_sessions" model="ir.cron">
            <field name="name">MES Kiosk: Close Stale Sessions</field>
            <field name="model_id" ref="model_mes_kiosk_session"/>
            <field name="state">code</field>
            <field name="code">model.cron_close_stale_operator_sessions()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
