<odoo>
    <record id="view_mes_copy_signals_wizard_form" model="ir.ui.view">
        <field name="name">mes.copy.signals.wizard.form</field>
        <field name="model">mes.copy.signals.wizard</field>
        <field name="arch" type="xml">
            <form string="Copy Signals">
                <field name="state" invisible="1"/>
                <field name="target_machine_id" invisible="1"/>
                <group invisible="state == 'conflicts'">
                    <field name="source_machine_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <group invisible="state == 'conflicts'">
                    <field name="copy_counts"/>
                    <field name="copy_events"/>
                    <field name="copy_processes"/>
                    <field name="clear_existing"/>
                </group>
                <p class="text-muted" invisible="state == 'conflicts' or clear_existing">
                    Missing signals are added and identical ones are skipped. Signals that differ are
                    listed next, so you can choose which to replace.
                </p>
                <div invisible="state != 'conflicts'">
                    <group>
                        <field name="source_machine_id" readonly="1"/>
                        <field name="add_count"/>
                        <field name="identical_count"/>
                    </group>
                    <p>
                        These signals exist on both machines but differ. Tick the ones to take from the
                        source machine; the rest stay as they are on this machine.
                    </p>
                    <field name="conflict_ids">
                        <tree editable="bottom" create="0" delete="0">
                            <field name="apply" widget="boolean_toggle"/>
                            <field name="signal_type"/>
                            <field name="reason"/>
                            <field name="target_object"/>
                            <field name="target_tag"/>
                            <field name="target_value" optional="show"/>
                            <field name="source_object"/>
                            <field name="source_tag"/>
                            <field name="source_value" optional="show"/>
                        </tree>
                    </field>
                </div>
                <footer>
                    <button name="action_copy_signals" string="Copy" type="object" class="btn-primary"
                            invisible="state == 'conflicts'"/>
                    <button name="action_apply_conflicts" string="Apply" type="object" class="btn-primary"
                            invisible="state != 'conflicts'"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_mes_mass_update_cumulative_wizard_form" model="ir.ui.view">
        <field name="name">mes.mass.update.cumulative.wizard.form</field>
        <field name="model">mes.mass.update.cumulative.wizard</field>
        <field name="arch" type="xml">
            <form string="Mass Update Cumulative Flag">
                <group>
                    <field name="machine_id" invisible="1"/>
                    <field name="is_cumulative"/>
                </group>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_mes_machine_settings_form" model="ir.ui.view">
        <field name="name">mes.machine.settings.form</field>
        <field name="model">mes.machine.settings</field>
        <field name="arch" type="xml">
            <form string="Machine Settings">
                <header>
                    <button name="action_clear_missing_flags" type="object"
                            string="Clear Missing Flags"
                            confirm="Clear the 'missing on PLC' marks for all signals of this machine?"/>
                    <button name="action_open_copy_signals_wizard" type="object" string="Copy Signals" class="oe_highlight"/>
                    <button name="action_open_mass_update_cumulative_wizard" type="object" string="Mass Update Cumulative" class="oe_highlight"/>
                    <button name="action_import_machine_counts" type="object" string="Import Counts CSV" class="oe_highlight"/>
                    <button name="action_import_machine_events" type="object" string="Import Alarms CSV" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Enter Machine Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="ip_connection"/>
                        </group>
                        <group>
                            <field name="ip_data"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Config Signals" name="signals">
                            <notebook>
                                <page string="Counts">
                                    <field name="count_tag_ids" context="{'active_test': False}">
                                        <tree editable="bottom" decoration-muted="not active" decoration-warning="missing_on_plc_since and active">
                                            <field name="count_id"/>
                                            <field name="tag_name"/>
                                            <field name="poll_type"/>
                                            <field name="poll_frequency"/>
                                            <field name="param_type"/>
                                            <field name="is_cumulative" widget="boolean_toggle"/>
                                            <field name="active" widget="boolean_toggle"/>
                                            <field name="missing_on_plc_since" optional="show" readonly="1"/>
                                            <field name="missing_report_count" optional="hide" readonly="1"/>
                                        </tree>
                                    </field>
                                </page>
                                <page string="Events">
                                    <field name="event_tag_ids" context="{'active_test': False}">
                                        <tree editable="bottom" decoration-muted="not active" decoration-warning="missing_on_plc_since and active">
                                            <field name="event_id"/>
                                            <field name="tag_name"/>
                                            <field name="plc_value"/>
                                            <field name="poll_type"/>
                                            <field name="poll_frequency"/>
                                            <field name="param_type"/>
                                            <field name="active" widget="boolean_toggle"/>
                                            <field name="missing_on_plc_since" optional="show" readonly="1"/>
                                            <field name="missing_report_count" optional="hide" readonly="1"/>
                                        </tree>
                                    </field>
                                </page>
                                <page string="Processes">
                                    <field name="process_tag_ids" context="{'active_test': False}">
                                        <tree editable="bottom" decoration-muted="not active" decoration-warning="missing_on_plc_since and active">
                                            <field name="process_id"/>
                                            <field name="tag_name"/>
                                            <field name="poll_type"/>
                                            <field name="poll_frequency"/>
                                            <field name="param_type"/>
                                            <field name="active" widget="boolean_toggle"/>
                                            <field name="missing_on_plc_since" optional="show" readonly="1"/>
                                            <field name="missing_report_count" optional="hide" readonly="1"/>
                                        </tree>
                                    </field>
                                </page>
                            </notebook>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_mes_machine_settings_tree" model="ir.ui.view">
        <field name="name">mes.machine.settings.tree</field>
        <field name="model">mes.machine.settings</field>
        <field name="arch" type="xml">
            <tree string="Machine Settings">
                <field name="name"/>
                <field name="ip_connection"/>
                <field name="ip_data"/>
            </tree>
        </field>
    </record>

    <record id="action_mes_machine_settings" model="ir.actions.act_window">
        <field name="name">Machine Settings</field>
        <field name="res_model">mes.machine.settings</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_mes_waste_loss_stat_tree" model="ir.ui.view">
        <field name="name">mes.waste.loss.stat.tree</field>
        <field name="model">mes.waste.loss.stat</field>
        <field name="arch" type="xml">
            <tree string="Waste Losses" create="false" edit="false" delete="false" default_order="waste_sum desc">
                <field name="name"/>
                <field name="waste_sum" sum="Total Waste"/>
                <field name="waste_per_hour" sum="Total per Hour"/>
            </tree>
        </field>
    </record>

    <record id="view_mes_downtime_loss_stat_tree" model="ir.ui.view">
        <field name="name">mes.downtime.loss.stat.tree</field>
        <field name="model">mes.downtime.loss.stat</field>
        <field name="arch" type="xml">
            <tree string="Downtime Losses" create="false" edit="false" delete="false" default_order="total_time desc">
                <field name="name"/>
                <field name="frequency" sum="Total Frequency"/>
                <field name="freq_per_hour" sum="Total Freq/h"/>
                <field name="total_time" sum="Total Time (min)"/>
                <field name="time_per_hour" sum="Total Time/h"/>
            </tree>
        </field>
    </record>
</odoo>