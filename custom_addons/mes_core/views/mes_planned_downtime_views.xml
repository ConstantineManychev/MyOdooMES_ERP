<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mes_planned_downtime_form" model="ir.ui.view">
        <field name="name">mes.planned.downtime.form</field>
        <field name="model">mes.planned.downtime</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="generate_flat_schedule_for_week" string="Generate now" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="rule_type"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="machine_ids" widget="many2many_tags"/>
                            <field name="event_id" options="{'no_create': True}"/>
                            <field name="origin" readonly="1"/>
                        </group>
                    </group>
                    <group invisible="origin == 'manual'" string="Started And Stopped">
                        <group>
                            <field name="started_by"/>
                            <field name="started_at"/>
                            <field name="open_ended" invisible="origin != 'workcenter'"/>
                        </group>
                        <group>
                            <field name="finished_by"/>
                            <field name="finished_at"/>
                        </group>
                    </group>
                    
                    <group invisible="rule_type != 'one_time'">
                        <field name="date_start" required="rule_type == 'one_time'"/>
                        <field name="date_end" required="rule_type == 'one_time'"/>
                    </group>

                    <group invisible="rule_type != 'weekly'" string="Active Period">
                        <field name="valid_from"/>
                        <field name="valid_to"/>
                    </group>

                    <notebook invisible="rule_type != 'weekly'">
                        <page string="Weekly Intervals" name="weekly_intervals">
                            <field name="weekly_line_ids">
                                <tree editable="bottom">
                                    <field name="weekday"/>
                                    <field name="hour_from" widget="float_time"/>
                                    <field name="hour_to" widget="float_time"/>
                                </tree>
                            </field>
                            <div class="text-muted">
                                Leave the times untouched to block the whole day
                                (00:00 to 23:59:59).
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mes_planned_downtime_tree" model="ir.ui.view">
        <field name="name">mes.planned.downtime.tree</field>
        <field name="model">mes.planned.downtime</field>
        <field name="arch" type="xml">
            <tree>
                <header>
                    <button name="%(mes_core.action_mes_downtime_planner)d" 
                            type="action" 
                            string="Plan New Downtime" 
                            class="oe_highlight" 
                            display="always"/>
                </header>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="event_id" optional="show"/>
                <field name="machine_ids" widget="many2many_tags"/>
                <field name="date_start" optional="show"/>
                <field name="date_end" optional="show"/>
                <field name="origin" optional="show"/>
                <field name="open_ended" optional="hide"/>
                <field name="started_by" optional="show"/>
                <field name="started_at" optional="hide"/>
                <field name="finished_by" optional="show"/>
                <field name="finished_at" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="action_mes_planned_downtime" model="ir.actions.act_window">
        <field name="name">Planned Downtime</field>
        <field name="res_model">mes.planned.downtime</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_mes_planned_downtime_tree"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Create a new planned downtime rule
          </p>
        </field>
    </record>

    <record id="view_mes_flat_downtime_tree" model="ir.ui.view">
        <field name="name">mes.flat.downtime.tree</field>
        <field name="model">mes.flat.downtime</field>
        <field name="arch" type="xml">
            <tree default_order="start_time desc" create="false" edit="false">
                <field name="machine_id"/>
                <field name="rule_id"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="duration" widget="float_time"/>
            </tree>
        </field>
    </record>

</odoo>